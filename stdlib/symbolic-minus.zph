# Simplifier and differentiation support for subtraction (-) and unary
# negation (neg of ...). eml.zph extends this foundation: the definition
# of eml is expressed as a difference, and its compiler uses both as term
# formers.
#
# PREREQUISITES:
#   .import decimal-arithmetic # or binary-arithmetic / binary-nand-arithmetic
#   .import symbolic-core
#   .import diff               # OPTIONAL -- the differentiation rules below
#   .import symbolic-minus     # are inert without it (no dstate facts exist)
#
# OPERATOR EXTENSION PROTOCOL contributions for the binary operator -:
# decompose, congruence, rewrites. neg needs NO decompose/congruence of
# its own: (neg of U) is an ordinary application fact, covered by
# symbolic-core's generic (F of U) rules. Its involution needs no rule
# either -- one inverseof declaration feeds the existing generic
# inverse-pair rule.
#
# NUMERIC FOLDING is inherited, not implemented: a red form (&5 - &3) IS
# an ordinary - fact, the natural module derives its = result, and the
# SN bridge adopts it. (&3 - &5) derives nothing over the naturals and
# falls back to itself -- undefinedness stays visible. Loading
# integer-arithmetic + symbolic-integers COMPLETES this partiality: the
# same term then folds to (neg zint &2).
#
# CANCELLATION: X - X equals &0 for each term, and x - (x - a) results in
# a. Both expressions are single-valued because nonnegative integers
# possess a single node each (integer-arithmetic.zph, ONE WORLD): at any
# location where the SN fold also answers X - X -- two equal numerals,
# either natural or signed -- the outcome is consistently the natural &0.
# Prior versions up to 1.0.1 left X - X out, as a zint difference folded
# to the zint zero (pos zint &0), and a rule would have added the natural
# &0 as an additional result; cancellation of symbolic terms was left to
# the polynomial layer. topoly continues to normalize entire polynomials,
# a task this local rule does not attempt: (x + y) - (y + x) remains
# unchanged here.
#
# Identities are FORMAL (domain caveats as in symbolic-core.zph).

.import symbolic-core

# ---------------------------------------------------------------------------
# neg is its own inverse: -(-u) = u, via the generic inverse-pair rule
# ---------------------------------------------------------------------------
neg inverseof neg

# ---------------------------------------------------------------------------
# Simplifier extension (1): decompose
# ---------------------------------------------------------------------------
((U - V) needssimp (U - V)) => (U needssimp U)
((U - V) needssimp (U - V)) => (V needssimp V)

# ---------------------------------------------------------------------------
# Simplifier extension (2): congruence
# ---------------------------------------------------------------------------
((U - V) needssimp (U - V), U simp P, V simp Q) => ((U - V) red (P - Q))

# ---------------------------------------------------------------------------
# Simplifier extension (3): rewrites. Conflict-free with the SN fold on
# the only overlap, red (X - &0) for numeral X: both paths yield X (the
# natural module's N - 0 result is canonical).
# ---------------------------------------------------------------------------
(T red (X - &0)) => (T rw X)
(T red (neg of &0)) => (T rw &0)

# X - X equals 0. Conflict-free with (X - &0) -- both yield &0 when
# applied to &0 - &0 -- and with the SN fold, which produces the natural
# &0 for identical numerals as well (refer to CANCELLATION above).
(T red (X - X)) => (T rw &0)

# x - (x - a) = a. A is a child of a child within the reduced form, hence
# normal (normal forms are closed under subterms), meaning the right-hand
# side fulfils the contract. Conflict-free: (X - &0) needs the subtrahend
# to be &0, not a - node; X - X would require X to equal (X - A); and the
# SN fold remains silent, as a numeric - fact needs two numerals. An
# inner difference that remains unfolded, like (&2 - &5) over the
# naturals, is not an exception: (&2 - (&2 - &5)) evaluates to &5.
(T red (X - (X - A))) => (T rw A)

# ---------------------------------------------------------------------------
# Differentiation extension: d(u - v)/dx = du/dx - dv/dx and
# d(-u)/dx = -(du/dx). neg's dstate comes from diff.zph's generic
# (F of U) rule; only - needs its own. neg gets a dedicated assemble rule
# (like ln): its derivative is not of the form G(u) for a named symbol G.
# ---------------------------------------------------------------------------
((U - V) dstate X) => (U dstate X)
((U - V) dstate X) => (V dstate X)

((U - V) dstate X,
 (U wrt X) deriv P,
 (V wrt X) deriv Q)
=> (((U - V) wrt X) deriv (P - Q))

((neg of U) dstate X,
 (U wrt X) deriv P)
=> (((neg of U) wrt X) deriv (neg of P))
