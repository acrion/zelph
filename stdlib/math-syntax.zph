# math-syntax.zph - the $( ... ) term island: conventional infix notation
# for building term graphs.
#
# PREREQUISITES: numeric literals inside islands delegate to zelph/number
# (they are pure &-literal sugar), so an arithmetic substrate must be
# loaded; the default import below takes care of that. Symbolic MEANING
# (simplify, diffby, topoly, ...) comes from the symbolic modules as
# usual; this module contributes syntax only.

# Default arithmetic substrate; import a different provider of
# "arithmetic" (or claim the ID via .provides) BEFORE this module to override:
.import binary-arithmetic

#
# An island desugars to exactly the graph structure the verbose syntax
# builds -- hash-consing makes both spellings meet at identical nodes,
# so sugar and verbose forms are freely mixable, in facts and in rules:
#
#   $( x^2 + 2*x + 1 ) diffby x
#   (T red $( X * 1 )) => (T rw X)        # node-identical to (X * &1)
#
# GRAMMAR:
#   expr    := <one level per declared precedence, loosest first>
#   factor  := '-' factor | power
#   power   := primary ('^' INTEGER)?             INTEGER >= 1
#   primary := INTEGER | IDENT '(' expr ')' | IDENT | '(' expr ')'
#
# The infix levels are GENERATED from the operator table below, which also
# feeds zelph/set-infix-display. One table, so the parser and the printer
# cannot drift apart: whatever the island can read, it can also write.
# Default table: + - at 10, * / at 20, all left-associative. ^ is not in
# it -- its right operand is an integer literal rather than an expression,
# so it stays the dedicated :power rule.
#
#   INTEGER  -> (zelph/number "...")  (the &-literal representation)
#   IDENT    -> a zelph variable if variable-shaped (single uppercase
#               letter or leading '_', as in native syntax), otherwise a
#               named node in the current language. Identifiers are
#               [A-Za-z_][A-Za-z0-9_]* -- atoms outside this charset
#               need the verbose syntax.
#   f(u)     -> (f of u); single-argument application only
#   -u       -> (neg of u); with symbolic-integers loaded, -3 promotes
#               to (neg zint &3) through the existing machinery
#   t^n      -> left-nested products ((t*t)*t)...; a dedicated pow
#               module may later replace this desugaring. t^1 is t;
#               t^0 is rejected.
#   t^n      -> (t ^ &n); ^ is a term former, not sugar for a product.
#               n >= 0, integer literal. t^0 is a valid term compiling to
#               the polynomial 1; t^1 simplifies to t. Symbolic or
#               negative exponents need the verbose syntax (t ^ n).
#
# EXTENDING THE NOTATION: math-syntax/operator adds a binary infix
# operator to the grammar AND to the display scheme in one step, so a
# module that teaches zelph a new operation can teach it the notation too:
#
#   %(math-syntax/operator "circ" 15)          # left-associative default
#   %(math-syntax/operator "**" 40 :right)
#
# Word-shaped operator names are matched with an identifier boundary, so
# "circ" does not match inside "circle"; they need surrounding whitespace
# (a circ b), symbolic ones do not. All operators sharing a precedence
# must share an associativity -- mixing them has no meaning and is an
# error rather than a silent choice.
#
# DELIBERATE OMISSIONS: no implicit multiplication (2x is an error,
# write 2*x), no unquote inside islands, no comparison operators, no
# string literals, no user-defined prefix or postfix operators.
#
# MECHANICS: the island is an inline keyword (3-argument
# zelph/register-keyword). The host's close-delimiter scan is raw; this
# handler arbitrates nested ')' via the :incomplete veto, keyed on
# parenthesis balance. Per the inline-keyword contract, the handler is
# side-effect-free until it accepts: PEG parse first, graph construction
# only afterwards.

%
# The one operator table: [name precedence associativity]. Higher
# precedence binds tighter. Consumed by build-grammar (parsing) and by
# zelph/set-infix-display (printing).
(def- operator-table @[["+" 10 :left] ["-" 10 :left]
                       ["*" 20 :left] ["/" 20 :left]])

# Everything except the generated infix levels and :expr.
(def- grammar-base
  ~{:ws (set " \t\r\n")
    :s* (any :ws)

    :int (group (* (constant :num) (? "&") (capture (some (range "09")))))

    :ident (capture (* (choice (range "az") (range "AZ") "_")
                       (any (choice (range "az") (range "AZ") (range "09") "_"))))

    :funcall (group (* (constant :call) :ident :s* "(" :s* :expr :s* ")"))
    :leaf (group (* (constant :leaf) :ident))
    :paren (* "(" :s* :expr :s* ")")
    :primary (choice :int :funcall :leaf :paren)

    :power (group (* (constant :pow) :primary
                     (? (* :s* "^" :s* (? "&") (capture (some (range "09")))))))

    :factor (choice (group (* (constant :neg) "-" :s* :factor)) :power)

    :main (* :s* :expr :s* -1)})

(defn- word-op?
  "Does the name start like an identifier? Such operators need a boundary
  check, or 'circ' would match the first four characters of 'circle'."
  [s]
  (def c (get s 0))
  (or (= c 95) (<= 97 c 122) (<= 65 c 90)))

(defn- op-pattern [name]
  (if (word-op? name)
    ~(* ,name (not (choice (range "az") (range "AZ") (range "09") "_")))
    name))

(defn- build-grammar []
  (def by-prec @{})
  (each entry operator-table
    (def prec (entry 1))
    (unless (in by-prec prec) (put by-prec prec @[]))
    (array/push (in by-prec prec) entry))

  (def g (table ;(kvs grammar-base)))
  (var operand :factor)
  (var level 0)

  # Tightest precedence first, so each level's operands are the next
  # tighter level and the LOOSEST ends up as :expr.
  (each prec (reverse (sort (keys by-prec)))
    (def entries (in by-prec prec))
    (def assocs (distinct (map |($ 2) entries)))
    (when (> (length assocs) 1)
      (error (string "math-syntax: operators at precedence " prec
                     " disagree on associativity")))
    # Longest name first: a shorter operator must not shadow a longer one
    # that starts with the same characters.
    (def names (sort (map |($ 0) entries)
                     (fn [a b] (> (length a) (length b)))))
    (def tag (if (= (first assocs) :right) :rchain :chain))
    (def rule (keyword "lvl" level))
    (put g rule
         ~(group (* (constant ,tag) ,operand
                    (any (* :s* (capture (choice ,;(map op-pattern names)))
                            :s* ,operand)))))
    (set operand rule)
    (++ level))

  (put g :expr operand)
  g)

(var term-peg (peg/compile (build-grammar)))

(defn- var-name?
  "Variable-shaped identifier, mirroring native syntax: a single
  uppercase letter, or a leading underscore."
  [s]
  (or (string/has-prefix? "_" s)
      (and (= 1 (length s)) (<= 65 (get s 0) 90))))

(defn- build
  "AST -> zelph/fact argument: a zelph/node, or a Janet symbol for a
  variable leaf (resolved into the statement's shared variable scope by
  the zelph/fact machinery)."
  [ast]
  (case (first ast)
    :num (zelph/number (ast 1))
    :leaf (let [s (ast 1)]
            (if (var-name? s) (symbol s) (zelph/resolve s)))
    :call (let [head (ast 1)]
            (zelph/fact (if (var-name? head) (symbol head) head)
                        "of"
                        (build (ast 2))))
    :neg (zelph/fact "neg" "of" (build (ast 1)))
    :pow (let [base (build (ast 1))]
           (if (= 2 (length ast))
             base
             (zelph/fact base "^" (zelph/number (ast 2)))))
    :chain (do
             (var acc (build (ast 1)))
             (var i 2)
             (while (< i (length ast))
               (set acc (zelph/fact acc (ast i) (build (ast (+ i 1)))))
               (+= i 2))
             acc)
    :rchain (do
              # Same element layout as :chain -- operand op operand ... --
              # folded from the right instead of the left.
              (def n (length ast))
              (var acc (build (ast (- n 1))))
              (var i (- n 2))
              (while (> i 0)
                (set acc (zelph/fact (build (ast (- i 1))) (ast i) acc))
                (-= i 2))
              acc)
    (error "math-syntax: internal error (unknown AST tag)")))

(defn- balanced?
  "Parenthesis balance -- the island's completeness criterion for the
  host's close-delimiter scan. Balanced but unparsable content is an
  ERROR, never :incomplete: a veto would swallow surrounding statement
  text."
  [t]
  (var d 0)
  (var ok true)
  (each c t
    (case c
      40 (++ d)
      41 (do (-- d) (when (< d 0) (set ok false)))))
  (and ok (= d 0)))

(defn- math-term-handler [text]
  (if (not (balanced? text))
    :incomplete
    (do
      (def parsed (peg/match term-peg text))
      (unless parsed
        (error (string "math-syntax: cannot parse term '" (string/trim text) "'")))
      (def r (build (first parsed)))
      (when (symbol? r)
        (error "math-syntax: a lone variable is not a term; islands must build structure"))
      r)))

# --- Display: render terms the way this module's parser reads them ------
#
# Registered HERE and not in the arithmetic modules on purpose: the
# notation is this module's, not theirs. A term appears in island form
# only where the default rendering would deviate -- where precedence
# actually removes parentheses, or where a numeral drops its sigil.
# Everything else keeps the form it has today.
#
# 'of' is registered in APPLICATION form: (f of u) is what this module's
# f(u) builds, and call notation is how it reads back. That also covers
# unary minus -- $( -x ) builds (neg of x) and renders as neg(x), which
# this grammar parses; a '-x' rendering would need a third form (prefix)
# and is not worth it. '=' stays unregistered: it belongs to the
# arithmetic modules and has no place in this grammar, so a result fact
# keeps '=' outside the island.
(zelph/register-display-scheme "math-syntax" "$( " " )"
  {:numeral-prefix "&"
   :name-first "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
   :name-chars "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"})

# The grammar's own operators, plus ^ -- which the parser handles as a
# dedicated rule (integer exponent) but which prints like any other infix.
(zelph/set-infix-display "math-syntax"
  [;(map |[($ 0) ($ 1) ($ 2)] operator-table) ["^" 30 :right]])

(zelph/set-application-display "math-syntax" ["of"])

(zelph/register-keyword "$(" ")" math-term-handler)

(defn math-syntax/operator
  "Add a binary infix operator to the island grammar and to the island
  display scheme in one step. name is the predicate, prec its precedence
  (higher binds tighter; the built-ins are + - at 10, * / at 20, ^ at 30),
  assoc :left (default) or :right.

  Registering only the DISPLAY -- via zelph/set-infix-display on this
  scheme -- would let the printer emit island syntax the island parser
  cannot read back. Going through this function keeps both sides in step."
  [name prec &opt assoc]
  (default assoc :left)
  (when (find |(= ($ 0) name) operator-table)
    (error (string "math-syntax/operator: '" name "' is already an operator")))
  (unless (or (= assoc :left) (= assoc :right))
    (error "math-syntax/operator: associativity must be :left or :right"))
  (array/push operator-table [name prec assoc])
  # All-or-nothing: compile FIRST, and take the entry back out if the
  # table is rejected (mixed associativity at one precedence). Otherwise a
  # failed call would leave the operator behind and every later call would
  # fail on a table the caller never asked for -- and the display registry
  # would already be one entry ahead of the parser, which is exactly the
  # drift this function exists to prevent.
  (def compiled
    (try (peg/compile (build-grammar))
         ([err] (array/pop operator-table) (error err))))
  (zelph/set-infix-display "math-syntax" [[name prec assoc]])
  (set term-peg compiled)
  nil)

(zelph/out "math-syntax loaded: $( ... ) term islands (infix with precedence)")
%
