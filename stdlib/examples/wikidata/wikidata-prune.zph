# --- Life sciences and chemistry -------------------------------------------
# Proteins, genes and compounds are the classic bulk import: millions of items
# that exist because a database was mirrored, not because anyone edits them.
.prune-nodes A P31 Q8054
.prune-nodes A P31 Q7187
.prune-nodes A P31 Q11173
.prune-nodes A P31 Q16521
.prune-nodes A P31 Q113145171
