.load /home/stefan/zelph/wikidata-20251222-all.bin
.lang zelph

# Written before the transitive path condition existed, which is why the class
# chains below are unrolled by hand -- and capped at length 3, so a violation
# inherited over four or more P279 steps is not in the report. The one-line
# form that supersedes all of it is
#
#   (K P279⁺ e1, K P279⁺ e2) => !
#
# and it is complete to any depth. Kept as it stands because the numbers taken
# with it are recorded against it.
#
# Name lookup is strictly per language, with no fallback: under `.lang zelph`
# the bare string "P279" below binds a FRESH zelph node rather than Wikidata's
# property, so every rule in this file matched nothing and the script reported
# a clean graph. The e1/e2 aliases were always correct; the predicate needed
# the same treatment.
.name P279 wikidata P279

# Top 1: concrete object vs abstract entity (93% of the total culprits)
#.name e1 wikidata Q4406616
#.name e2 wikidata Q7048977

# Top 2: artificial object vs natural object
.name e1 wikidata Q16686448
.name e2 wikidata Q1970309

# Top 3: natural physical object vs artificial physical object
#.name e1 wikidata Q16686022
#.name e2 wikidata Q8205328

# Top 4: person vs organization
#.name e1 wikidata Q215627
#.name e2 wikidata Q43229

# =============================================================================
# Path lengths 1-3 on each side, all combinations
# =============================================================================

# Depth 1+1
(*{(K "P279" e1) (K "P279" e2)} ~ conjunction) => !

# Depth 1+2 and 2+1
(*{(K "P279" e1) (K "P279" Y) (Y "P279" e2)} ~ conjunction) => !
(*{(K "P279" X) (X "P279" e1) (K "P279" e2)} ~ conjunction) => !

# Depth 2+2
(*{(K "P279" X) (X "P279" e1) (K "P279" Y) (Y "P279" e2)} ~ conjunction) => !

# Depth 1+3 and 3+1
(*{(K "P279" e1) (K "P279" A) (A "P279" B) (B "P279" e2)} ~ conjunction) => !
(*{(K "P279" A) (A "P279" B) (B "P279" e1) (K "P279" e2)} ~ conjunction) => !

# Depth 2+3 and 3+2
(*{(K "P279" X) (X "P279" e1) (K "P279" A) (A "P279" B) (B "P279" e2)} ~ conjunction) => !
(*{(K "P279" A) (A "P279" B) (B "P279" e1) (K "P279" Y) (Y "P279" e2)} ~ conjunction) => !

# Depth 3+3
(*{(K "P279" A) (A "P279" B) (B "P279" e1) (K "P279" C) (C "P279" D) (D "P279" e2)} ~ conjunction) => !

.run-export disjointness-violations-var-length1-3.jsonl
