#!/usr/bin/env zelph
# dev_scripts/paper/s3_macro_chain.zph
# Macro-chain compilation (-,+,*,/) and the compile/simplify round trip: the
# resulting compiled x - y tree is the Table-S2 witness eml(ln x, exp y), with
# ln and exp expanded into their EML macros; simplifying it gives (x - y)
# back.
# Evidence scripts print the FULL derivation trace: the paper quotes specific
# deduction lines, and each mode except 'all' shows only deductions anchored
# to statements from the session, thereby omitting the majority of entries in
# a log.
.deductions all
.import decimal-arithmetic
.import symbolic-core
.import eml
x ~ symvar
y ~ symvar

:emlcompile (x - y)
(:emlcompile (x - y)) = F
(:emlcompile (x - y)) = F

:emlcompile (x + y)
(:emlcompile (x + y)) = F

:emlcompile (x * y)
(:emlcompile (x * y)) = F

:emlcompile (x / y)
(:emlcompile (x / y)) = F

:simplify ((&1 eml ((&1 eml x) eml &1)) eml (y eml &1))
(:simplify ((&1 eml ((&1 eml x) eml &1)) eml (y eml &1))) = X
(:simplify ((&1 eml ((&1 eml x) eml &1)) eml (y eml &1))) = X
