#!/usr/bin/env zelph
# dev_scripts/paper/s1_eq5_derivation.zph
# Flagship artifact: zelph derives paper Eq. (5) with full provenance.
# Evidence scripts print the FULL derivation trace: the paper quotes
# individual deduction lines, and the default 'focus' mode shows only
# deductions anchored to interactively entered statements, which silently
# drops most of them from a log.
.deductions all
.import decimal-arithmetic
.import symbolic-core
.import eml
x ~ symvar
:simplify (&1 eml ((&1 eml x) eml &1))
.run
(:simplify (&1 eml ((&1 eml x) eml &1))) = X
(:simplify (&1 eml ((&1 eml x) eml &1))) = X
