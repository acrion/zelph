#!/usr/bin/env zelph
# dev_scripts/paper/s1_eq5_derivation.zph
# Flagship artefact: zelph derives paper Eq. (5), outputs each step of the
# derivation in sequence, and subsequently rebuilds the justification of the
# outcome (.explain, depth 0 = unlimited), relying solely on the graph.
# Evidence scripts print the FULL derivation trace: the paper quotes specific
# deduction lines, and every mode except 'all' shows only deductions anchored
# to session statements, thereby omitting most entries from the log.
.deductions all
.import decimal-arithmetic
.import symbolic-core
.import eml
x ~ symvar
:simplify (&1 eml ((&1 eml x) eml &1))
(:simplify (&1 eml ((&1 eml x) eml &1))) = X
(:simplify (&1 eml ((&1 eml x) eml &1))) = X
.explain ((:simplify (&1 eml ((&1 eml x) eml &1))) = (ln of x)) 0
