#!/usr/bin/env zelph
# dev_scripts/paper/s4_sharing.zph
# Hash-consing: EML trees are maximally shared DAGs. When two trees are
# constructed separately yet have the same structure, they are ONE node, and
# the compiled (ln of x) is literally that node -- shared verbatim within
# every compiled tree that includes ln x. (Should "identical-node" print
# false, notify: this indicates Janet's = does not compare node identity, and
# the probe must be revised.)
# Evidence scripts print the FULL derivation trace: the paper quotes specific
# deduction lines, and each mode except 'all' shows only deductions anchored
# to session statements, thereby omitting most of them from a log.
.deductions all
.import decimal-arithmetic
.import symbolic-core
.import eml
x ~ symvar
y ~ symvar
%(defn ex [t] (zelph/fact t "eml" (zelph/number "1")))
%(defn lg [t] (zelph/fact (zelph/number "1") "eml" (ex (zelph/fact (zelph/number "1") "eml" t))))
%(def a (lg "x"))
%(def b (zelph/fact (zelph/number "1") "eml" (zelph/fact (zelph/fact (zelph/number "1") "eml" "x") "eml" (zelph/number "1"))))
%(print (string "identical-node: " (= a b)))
:emlcompile (ln of x)
:emlcompile (x * y)
:emlcompile (x / y)
%(let [t (zelph/fact "ln" "of" "x")] (print (string "compiled-ln-shared: " (zelph/exists (zelph/fact t "emlcompile" t) "=" (lg "x")))))
