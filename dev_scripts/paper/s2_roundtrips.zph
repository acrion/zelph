#!/usr/bin/env zelph
# dev_scripts/paper/s2_roundtrips.zph
# Compile/reduce round trips for exp and ln in one session.
# Evidence scripts print the FULL derivation trace: the paper quotes
# individual deduction lines, and every mode but 'all' shows only deductions
# anchored to statements of the session, which drops most of them from a log.
.deductions all
.import decimal-arithmetic
.import symbolic-core
.import eml
x ~ symvar

:emlcompile (exp of x)
(:emlcompile (exp of x)) = F
(:emlcompile (exp of x)) = F

:simplify (x eml &1)
(:simplify (x eml &1)) = X
(:simplify (x eml &1)) = X

:emlcompile (ln of x)
(:emlcompile (ln of x)) = F
(:emlcompile (ln of x)) = F

:simplify (&1 eml ((&1 eml x) eml &1))
(:simplify (&1 eml ((&1 eml x) eml &1))) = X
(:simplify (&1 eml ((&1 eml x) eml &1))) = X
